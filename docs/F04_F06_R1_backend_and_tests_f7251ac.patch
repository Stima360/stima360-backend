+class ReadyCursor:
+    def __init__(self):
+        self.query = ""
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *args):
+        return False
+
+    def execute(self, query, *args):
+        self.query = query
+
+    def fetchone(self):
+        if "FROM stima_pdf_artifacts" in self.query:
+            return ({}, "ready", PDF, hashlib.sha256(PDF).hexdigest())
+        return (1,)
+
+
+class ReadyConnection:
+    def __init__(self):
+        self.committed = False
+        self.closed = False
+
+    def cursor(self):
+        return ReadyCursor()
+
+    def commit(self):
+        self.committed = True
+
+    def rollback(self):
+        pass
+
+    def close(self):
+        self.closed = True
+        raise InterfaceError("synthetic-close-after-commit")
+
+
+@pytest.mark.parametrize("operation", [stima_pdf.download, stima_pdf.generate])
