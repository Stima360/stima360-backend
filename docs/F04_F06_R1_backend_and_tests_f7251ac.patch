+def _execute_submission(receipt):
+    if receipt.row["status"] in {"completed", "attention"}:
+        return receipt.envelope()
+    raw = dict(receipt.row["request_payload"])
+    if receipt.row["kind"] == "quick":
+        raw["client_request_id"] = receipt.request_id
