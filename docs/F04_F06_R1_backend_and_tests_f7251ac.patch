+        try {
+          return route.fulfill({ contentType: file.endsWith('.js') ? 'text/javascript' : 'text/html',
+            body: await readFile(resolve(repo, 'site-preview/public', file)) });
+        } catch { /* A missing source must remain visible in the test. */ }
+      }
+    }
