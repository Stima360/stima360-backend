+  // C3.5 - la prova della casella marketing, mandata con la scelta: il testo
+  // della casella cosi' come la pagina lo mostra e l'impronta SHA-256 della
+  // privacy.html collegata, letta all'apertura della pagina. Mai bloccante:
+  // se la lettura non riesce entro 1,5 secondi si manda vuota e la stima procede.
+  function testoCasellaMarketing() {
+    const etichetta = document.querySelector('label[for="marketing"]');
+    return etichetta ? etichetta.textContent.replace(/\s+/g, ' ').trim() : '';
+  }
+  const improntaPrivacy = (async () => {
+    try {
+      const link = document.querySelector('label[for="privacy"] a[href="privacy.html"]');
+      const r = await fetch(link ? link.href : 'privacy.html', { cache: 'no-store' });
+      if (!r.ok || !window.crypto || !window.crypto.subtle) return '';
+      const hash = await window.crypto.subtle.digest('SHA-256', await r.arrayBuffer());
+      return Array.from(new Uint8Array(hash)).map(b => b.toString(16).padStart(2, '0')).join('');
+    } catch (_) {
+      return '';
+    }
+  })();
+  function attendiImprontaPrivacy() {
+    return Promise.race([improntaPrivacy, new Promise(fatto => setTimeout(() => fatto(''), 1500))]);
+  }
+
